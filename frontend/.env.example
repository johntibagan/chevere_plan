# Copiar a .env y rellenar (no subir .env a git).
# No se empaqueta como asset: inyectar en compile-time:
#   flutter run --dart-define-from-file=.env
# NUNCA pongas SUPABASE_SERVICE_ROLE_KEY aquí (solo anon/publishable).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
# Client ID del OAuth tipo "Web application" en Google Cloud (no el de Android)
GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Google Maps Platform (recomendado para ubicación exacta + mapa).
# Guía: docs/google-maps-setup.md
# Activar: Maps SDK for Android, Places API (New), Geocoding API.
# Restricciones API: solo esas 3. En MVP REST, no restrinjas por app Android
# (esa restricción bloquea llamadas HTTP desde Dart); o usa dos keys.
GOOGLE_MAPS_API_KEY=
# Tope diario LOCAL (Place Details + Autocomplete + Geocoding)
GOOGLE_PLACES_DAILY_LIMIT=80

# También en android/local.properties (para el Maps SDK nativo):
#   GOOGLE_MAPS_API_KEY=la_misma_key

# Geoapify (fallback si no hay Google o se agota cupo local).
GEOAPIFY_API_KEY=
GEOAPIFY_DAILY_LIMIT=100
