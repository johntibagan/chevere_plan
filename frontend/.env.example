# Copiar a .env y rellenar (no subir .env a git).
# No se empaqueta como asset: inyectar en compile-time:
#   flutter run --dart-define-from-file=.env
# NUNCA pongas SUPABASE_SERVICE_ROLE_KEY aquí (solo anon/publishable).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
# Client ID del OAuth tipo "Web application" en Google Cloud (no el de Android)
GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# Geoapify (recomendado): autocomplete + reverse sin tarjeta.
# Crear key gratis en https://www.geoapify.com/get-started-with-maps-api/
GEOAPIFY_API_KEY=
# Tope diario LOCAL de llamadas en prueba (el free tier del proveedor es ~3000/día)
GEOAPIFY_DAILY_LIMIT=100
