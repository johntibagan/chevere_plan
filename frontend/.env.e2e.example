# Copiar a .env.e2e (gitignored). Proyecto Supabase **e2e** (no prod).
# Uso:
#   patrol test --dart-define-from-file=.env.e2e
#
# NUNCA pongas SUPABASE_SERVICE_ROLE_KEY aquí.

SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_WEB_CLIENT_ID=
GEOAPIFY_API_KEY=
GEOAPIFY_DAILY_LIMIT=100

# Opcional — restaurar sesión sin abrir UI de Google (recomendado en P0).
# Obtén tokens tras un login manual (p. ej. desde logs de debug / session JSON
# de Supabase Auth) en el proyecto e2e. Caducan: renueva cuando fallen tests.
E2E_SUPABASE_ACCESS_TOKEN=
E2E_SUPABASE_REFRESH_TOKEN=

# Segunda cuenta (no root) para tests de público/privado cruzados. Opcional.
E2E_SUPABASE_REFRESH_TOKEN_B=

# Enlace real de Google Maps para el test de pegar (opcional).
E2E_MAPS_URL=

