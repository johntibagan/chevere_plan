# Copiar a backend/.env (gitignored).
#
# Windows: Dashboard → Database → Connect → Session pooler
#   postgresql://postgres.PROJECT:PASSWORD@aws-N-REGION.pooler.supabase.com:5432/postgres
#
# Si tu red tiene IPv6, también vale la URI directa (db.PROJECT.supabase.co:5432).
# No uses el transaction pooler (puerto 6543).
SUPABASE_DB_URL=
