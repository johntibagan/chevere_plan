# Copiar a backend/.env (gitignored).
# Dashboard → Project Settings → Database → Connection string → URI
# Usa la conexión DIRECTA (puerto 5432, host db.<ref>.supabase.co).
# No uses el pooler (6543): DDL largo (DIVIPOLA) falla o se corta.
#
# Ejemplo:
# SUPABASE_DB_URL=postgresql://postgres:TU_PASSWORD@db.xxxx.supabase.co:5432/postgres
SUPABASE_DB_URL=

